<Window x:Class="WimFluent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WIM (Where Is Music)"
        Icon="assets/app.ico"
        Width="1280" Height="720" MinWidth="1000" MinHeight="620"
        Background="Transparent"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen"
        PreviewMouseDown="Window_PreviewMouseDown" Deactivated="Window_Deactivated"
        LocationChanged="Window_Deactivated" SizeChanged="Window_Deactivated">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                      GlassFrameThickness="-1" UseAeroCaptionButtons="True"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <TextBlock Grid.Row="0" Text="WIM" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   VerticalAlignment="Center" Margin="16,0,0,0"/>

        <!-- Контент -->
        <Grid Grid.Row="1" Margin="40,8,40,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="460"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка -->
            <StackPanel Grid.Column="0" Margin="0,0,32,0">
                <TextBlock Text="WIM (Where Is Music)" FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <!-- Поиск -->
                <Grid Margin="0,24,0,0" Width="460" HorizontalAlignment="Left" Height="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Style="{StaticResource FluentTextBox}"
                             Tag="Поиск..." KeyDown="SearchBox_KeyDown"
                             TextChanged="SearchBox_TextChanged" GotKeyboardFocus="SearchBox_GotFocus"/>
                    <Button Grid.Column="1" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                            Padding="14,0" Width="48" Click="Search_Click" ToolTip="Найти"
                            x:Name="SearchButton">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
                    </Button>
                </Grid>

                <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="3" Width="460"
                             HorizontalAlignment="Left" Margin="0,6,0,0"
                             Foreground="{DynamicResource Accent}" Background="Transparent"
                             BorderThickness="0" Visibility="Hidden"/>

                <!-- Название трека (размер шрифта подбирается в коде) -->
                <TextBlock x:Name="TitleText" Text="Название" FontSize="64" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" Width="560"
                           HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                           Margin="-2,20,0,16"/>

                <!-- Информация -->
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Width="32" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ArtistText" Text="Композитор трека" FontSize="20"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="&#xE93C;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Width="32" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AlbumText" Text="Альбом" FontSize="20"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Width="32" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DurationText" Text="Длительность" FontSize="20"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>

                <TextBlock x:Name="SourceText" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                           Margin="0,14,0,0" MinHeight="18"/>

                <TextBlock x:Name="LinksLabel" Text="Открыть в сервисе" FontSize="13"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,12,0,6"
                           Visibility="Collapsed"/>
                <WrapPanel x:Name="LinksPanel" Orientation="Horizontal" Width="560"
                           HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- Правая колонка: обложка -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,8,0,0">
                <Grid Width="420" Height="420" HorizontalAlignment="Center">
                    <Border CornerRadius="10" Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270"
                                              Opacity="0.18" Color="Black"/>
                        </Border.Effect>
                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="96"
                                   Foreground="{DynamicResource PlaceholderGlyph}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Rectangle RadiusX="10" RadiusY="10">
                        <Rectangle.Fill>
                            <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill"/>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button x:Name="PrevButton" Style="{StaticResource SubtleButton}" Width="40" Height="36"
                            Click="Prev_Click" IsEnabled="False">
                        <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                    </Button>
                    <TextBlock x:Name="CounterText" Width="70" TextAlignment="Center" VerticalAlignment="Center"
                               FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
                    <Button x:Name="NextButton" Style="{StaticResource SubtleButton}" Width="40" Height="36"
                            Click="Next_Click" IsEnabled="False">
                        <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Футер -->
        <Grid Grid.Row="2" Margin="40,0,28,0">
            <TextBlock Text="[RELEASE]" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="LangButton" Style="{StaticResource SubtleButton}" Width="40" Height="34"
                        Padding="0" ToolTip="Язык" Click="Lang_Click">
                    <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
                </Button>
                <Button x:Name="ThemeButton" Style="{StaticResource SubtleButton}" Width="40" Height="34"
                        Padding="0" Margin="4,0,0,0" ToolTip="Сменить тему" Click="Theme_Click">
                    <TextBlock x:Name="ThemeIcon" FontFamily="{StaticResource IconFont}" FontSize="16"/>
                </Button>
                <Button x:Name="AboutButton" Style="{StaticResource SubtleButton}" Margin="4,0,0,0"
                        Content="Об приложении" Click="About_Click"/>
            </StackPanel>
        </Grid>

        <!-- История поиска (выпадающий список под полем) -->
        <Popup x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom"
               VerticalOffset="4" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
            <Border x:Name="HistoryCard" Width="{Binding ActualWidth, ElementName=SearchBox}"
                    Background="{DynamicResource SolidBg}" BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="4">
                <StackPanel>
                    <Grid Margin="8,4,0,2">
                        <TextBlock x:Name="HistoryTitle" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        <Button x:Name="HistoryClear" Style="{StaticResource SubtleButton}" FontSize="12"
                                Padding="8,3" HorizontalAlignment="Right" Focusable="False"
                                Click="HistoryClear_Click"/>
                    </Grid>
                    <StackPanel x:Name="HistoryList"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Выбор языка -->
        <Popup x:Name="LangPopup" PlacementTarget="{Binding ElementName=LangButton}" Placement="Top"
               VerticalOffset="-6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource SolidBg}" BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="170">
                <StackPanel x:Name="LangList"/>
            </Border>
        </Popup>
    </Grid>
</Window>
